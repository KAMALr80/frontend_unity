# Unity Wholesale storefront — environment variables.
# Copy to .env.local (local) or set them in the hosting dashboard (production). Never commit real values.

# Backend origin, no trailing slash and without /api (the app adds /api itself).
# Images it serves (/storage/**, /api/media/**) are allowed automatically by next.config.ts.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Which homepage config the storefront loads from the backend (admin → Homepage).
NEXT_PUBLIC_HOMEPAGE_CLIENT=unity-web

# Public origin of the storefront (canonical URLs, sitemap.xml, robots.txt, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true only after the API implements the cookie contract in SECURITY_BACKEND_REQUIREMENTS.md.
NEXT_PUBLIC_COOKIE_AUTH=false

# Optional extra image host for next/image, with a wildcard path, e.g. https://cdn.example.com/**
# IMAGE_CDN_URL=

# UI theme: forge | pallet
NEXT_PUBLIC_THEME=forge

# Shared secret the Gateway sends to /api/revalidate so homepage edits show up immediately (same value as the backend FRONTEND_REVALIDATE_SECRET)
REVALIDATE_SECRET=
